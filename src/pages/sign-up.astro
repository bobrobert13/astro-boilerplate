---
import { SignUp } from '@clerk/astro/components';
import StarterLayout from '@/layouts/StarterLayout.astro';
import { APP_CONFIG, APP_ROUTES } from '@/config/index.config';
import { isAuthEnabled } from '@/services/auth/auth-provider';

export const prerender = false;

if (!isAuthEnabled(import.meta.env.AUTH_PROVIDER)) {
  return new Response(null, { status: 404 });
}
---

<StarterLayout title="Crear cuenta" description={`Crea una cuenta en ${APP_CONFIG.name}.`}>
  <main class="starter-shell starter-section">
    <div class="starter-panel starter-panel--narrow">
      <p class="starter-eyebrow">Autenticación</p>
      <h1>Crear cuenta</h1>
      <SignUp fallbackRedirectUrl={APP_ROUTES.account} signInUrl={APP_ROUTES.signIn} />
    </div>
  </main>
</StarterLayout>
