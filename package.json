{
  "name": "astro-boilerplate",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Boilerplate Astro SSR para aplicaciones de alcance medio y alto.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project unit tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "npm outdated",
    "deps:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.0",
    "@astrojs/vue": "^7.0.2",
    "@clerk/astro": "^4.0.8",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.2.0",
    "axios": "^1.19.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.5.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "20.11.2",
    "msw": "2.15.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "@clerk/astro": {
      "nanoid": "5.1.16"
    },
    "postcss": {
      "nanoid": "3.3.17"
    },
    "fast-uri": "3.1.5"
  }
}
