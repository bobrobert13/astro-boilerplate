# Runtime defaults are deliberately usable without external services.

# fixture | api
PUBLIC_DATA_SOURCE=fixture
PUBLIC_API_BASE_URL=/api
PUBLIC_API_TIMEOUT_MS=10000

# none | clerk
# Set both Clerk keys only when enabling the optional auth example.
AUTH_PROVIDER=none
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
